# Makes the build output a core package that other CMake projects link
# against instead of building core (see prebuilt-core.cmake): the static and
# Windows import libraries go to EO_CORE_LIB_DIR, next to a description of
# the targets, eo-core-targets.cmake. Included at the end of the top-level
# CMakeLists.txt, once all targets exist.

# Targets other projects link or run, and where their files are
set(_eo_package_bin_targets
    kernel kernel_network UnicodeConverter graphics doctrenderer
    PdfFile XpsFile DjVuFile OFDFile Fb2File EpubFile HtmlFile2 DocxRenderer
    IWorkFile HWPFile StarMathConverter SMCustomShape2OOXML ooxmlsignature
    x2tlib CryptoPPLib CompoundFileLib x2t)
set(_eo_package_tools_targets allfontsgen allthemesgen)

file(RELATIVE_PATH _eo_rel_bin   "${EO_CORE_LIB_DIR}/.." "${EO_CORE_OUTPUT_DIR}")
file(RELATIVE_PATH _eo_rel_tools "${EO_CORE_LIB_DIR}/.." "${EO_CORE_TOOLS_DIR}")
get_filename_component(_eo_rel_lib "${EO_CORE_LIB_DIR}" NAME)

set(_eo_content "")
string(APPEND _eo_content
    "# Generated by core (cmake/core-package.cmake), read by cmake/prebuilt-core.cmake.\n"
    "# Paths are relative to the package root.\n"
    "set(EO_CORE_PACKAGE_FORMAT 1)\n"
    "set(EO_CORE_PACKAGE_BIN \"${_eo_rel_bin}\")\n"
    "set(EO_CORE_PACKAGE_TOOLS \"${_eo_rel_tools}\")\n"
    "set(EO_CORE_PACKAGE_TARGETS)\n")

set(_eo_lib_files)
set(_eo_lib_targets)
foreach(_t IN LISTS _eo_package_bin_targets _eo_package_tools_targets)
    if(NOT TARGET ${_t})
        continue()
    endif()
    get_target_property(_type ${_t} TYPE)
    if(_t IN_LIST _eo_package_tools_targets)
        set(_dir "${_eo_rel_tools}")
    else()
        set(_dir "${_eo_rel_bin}")
    endif()

    if(_type STREQUAL "STATIC_LIBRARY")
        set(_file "${_eo_rel_lib}/$<TARGET_FILE_NAME:${_t}>")
        list(APPEND _eo_lib_files "$<TARGET_FILE:${_t}>")
        list(APPEND _eo_lib_targets ${_t})
    elseif(APPLE AND _type STREQUAL "SHARED_LIBRARY" AND (_t STREQUAL "ooxmlsignature"))
        # copy_framework_to_folder() copies the whole bundle
        set(_file "${_dir}/${_t}.framework/$<TARGET_FILE_NAME:${_t}>")
    else()
        set(_file "${_dir}/$<TARGET_FILE_NAME:${_t}>")
    endif()

    string(APPEND _eo_content
        "list(APPEND EO_CORE_PACKAGE_TARGETS ${_t})\n"
        "set(EO_CORE_PACKAGE_${_t}_TYPE ${_type})\n"
        "set(EO_CORE_PACKAGE_${_t}_FILE \"${_file}\")\n")

    if(_t STREQUAL "ooxmlsignature" AND APPLE)
        string(APPEND _eo_content "set(EO_CORE_PACKAGE_${_t}_FRAMEWORK TRUE)\n")
    endif()

    if(WIN32 AND _type STREQUAL "SHARED_LIBRARY")
        string(APPEND _eo_content
            "set(EO_CORE_PACKAGE_${_t}_IMPLIB \"${_eo_rel_lib}/$<TARGET_LINKER_FILE_NAME:${_t}>\")\n")
        list(APPEND _eo_lib_files "$<TARGET_LINKER_FILE:${_t}>")
        list(APPEND _eo_lib_targets ${_t})
    endif()

    # Static libraries pass on what they link; only imported targets
    # (Boost::system, ...) mean the same in the consuming project
    if(_type STREQUAL "STATIC_LIBRARY")
        get_target_property(_links ${_t} INTERFACE_LINK_LIBRARIES)
        set(_kept)
        foreach(_l IN LISTS _links)
            if(_l MATCHES "::" AND NOT _l MATCHES "^\\$<")
                list(APPEND _kept "${_l}")
            endif()
        endforeach()
        if(_kept)
            string(APPEND _eo_content "set(EO_CORE_PACKAGE_${_t}_LINK \"${_kept}\")\n")
        endif()
    endif()
endforeach()

file(GENERATE OUTPUT "${EO_CORE_LIB_DIR}/eo-core-targets.cmake" CONTENT "${_eo_content}")

# The libraries are built in other directories, so not POST_BUILD there
if(_eo_lib_files)
    add_custom_target(eo_core_package_libs ALL
        COMMAND ${CMAKE_COMMAND} -E make_directory "${EO_CORE_LIB_DIR}"
        COMMAND ${CMAKE_COMMAND} -E copy_if_different ${_eo_lib_files} "${EO_CORE_LIB_DIR}/"
        COMMENT "Copying the static and import libraries to ${EO_CORE_LIB_DIR}"
        VERBATIM)
    add_dependencies(eo_core_package_libs ${_eo_lib_targets})
endif()
